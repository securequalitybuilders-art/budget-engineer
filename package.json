{
  "name": "budget-engineer-os",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 1000",
    "typecheck": "tsc --noEmit",
    "test": "set NODE_OPTIONS=--max-old-space-size=8192 && vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run",
    "test:ci": "npm run typecheck && set NODE_OPTIONS=--max-old-space-size=8192 && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:kpi3": "vitest run --config vitest.integration.config.ts src/__tests__/integration/kpi3Promptfoo.test.ts",
    "eval:kpi3:cli": "node eval/run-cli-gate.mjs",
    "eval:kpi3:ci": "node eval/run-cli-gate.mjs",
    "test:release": "npm run typecheck && npm run build:only && npm test && npm run test:integration",
    "test:smoke": "playwright test --config=playwright.config.ts",
    "lighthouse": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "fflate": "^0.8.3",
    "framer-motion": "^11.2.12",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.400.0",
    "makerjs": "^0.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "three": "^0.183.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "promptfoo": "^0.122.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
